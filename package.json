{
  "name": "ledger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:start": "pg_ctl -D .pgdata -o '-p 5433 -k /tmp' -l .pgdata/server.log start",
    "db:stop": "pg_ctl -D .pgdata stop",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "probe": "tsx scripts/run-probe.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed:history": "tsx scripts/seed-history.ts",
    "parse": "tsx scripts/parse-run.ts",
    "verify": "tsx scripts/verify-actions.ts",
    "digest": "tsx scripts/send-digest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@auth/drizzle-adapter": "^1.11.3",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^8.0.11",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
