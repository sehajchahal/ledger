# Postgres. `npm run db:start` boots a local cluster in .pgdata on port 5433.
DATABASE_URL=postgres://ledger@localhost:5433/ledger

# Answer engines. Both are optional.
#
# With neither set, Ledger runs on the fixture provider: deterministic,
# realistic answers generated locally so the whole product is demoable without
# spending anything. Runs produced this way are labelled as demo data in the UI
# and must never be shown to a customer as a measurement.
#
# Set either key and probes switch to that engine automatically.
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# Auth.js. AUTH_SECRET is required — generate with `openssl rand -base64 32`.
AUTH_SECRET=
# SMTP for magic links. With these unset, sign-in links are printed to the
# server log instead of emailed, which is what you want locally.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# Second probe engine (ChatGPT with web search), so the same prompt can be
# compared across answer engines. Optional.
OPENAI_API_KEY=
OPENAI_PROBE_MODEL=gpt-4o
