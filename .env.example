# Postgres.
# Local:  `npm run db:start` boots a cluster in .pgdata on port 5433.
# Hosted: use the POOLED connection string (Neon's -pooler host, Supabase's
#         6543 port). Prepared statements are turned off automatically when a
#         pooled URL is detected, because PgBouncer in transaction mode cannot
#         hold them across queries.
DATABASE_URL=postgres://ledger@localhost:5433/ledger

# Answer engines. Both are optional.
#
# With neither set, Ledger runs on the fixture provider: deterministic,
# realistic answers generated locally so the whole product is demoable without
# spending anything. Runs produced this way are labelled as demo data in the UI
# and must never be shown to a customer as a measurement.
#
# Set either key and probes switch to that engine automatically.
PERPLEXITY_API_KEY=
ANTHROPIC_API_KEY=

# Auth.js. AUTH_SECRET is required — generate with `openssl rand -base64 32`.
AUTH_SECRET=
# SMTP for magic links. With these unset, sign-in links are printed to the
# server log instead of emailed, which is what you want locally.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=

# Second probe engine (ChatGPT with web search), so the same prompt can be
# compared across answer engines. Optional.
OPENAI_API_KEY=
OPENAI_PROBE_MODEL=gpt-4o

# Absolute origin, used for links inside emails. Set this in production or the
# approve links in digests will point at localhost.
APP_URL=http://localhost:3000

# Shared secret for the scheduled routes under /api/cron/*. They spend money, so
# without this set they refuse to run rather than defaulting to open. On Vercel
# this is generated for you; set it yourself anywhere else.
CRON_SECRET=
